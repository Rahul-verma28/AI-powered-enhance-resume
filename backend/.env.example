# ── AI Provider (switch without code changes) ──────────────
AI_PROVIDER=ollama                     # ollama | claude | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
CLAUDE_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx

# ── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/resumeai

# ── Redis (optional — for Bull queue) ───────────────────────
REDIS_URL=redis://default:xxxx@upstash.io:6379

# ── Storage ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# ── Auth ────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# ── App ─────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
